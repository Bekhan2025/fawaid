{
  "name": "nextjs_tailwind_shadcn_ts",
  "version": "0.2.1",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000 2>&1 | tee dev.log",
    "build": "next build && cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/",
    "start": "NODE_ENV=production bun .next/standalone/server.js 2>&1 | tee server.log",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "validate:content": "bun scripts/validate-content.ts",
    "check": "bun run lint && bun run typecheck && bun run validate:content && bun run test:content",
    "content:generate": "python3 scripts/parse_toc.py && python3 scripts/extract_book.py && bun run validate:content",
    "test:content": "bun test scripts/validate-content.test.ts scripts/book-search.test.ts scripts/layer-availability.test.ts",
    "test:e2e": "playwright test",
    "bundle:report": "bun scripts/bundle-report.ts",
    "release:check": "bun run check && bun run build && bun run bundle:report && bun run test:e2e",
    "build:pages": "STATIC_EXPORT=1 NEXT_PUBLIC_BASE_PATH=/fawaid next build",
    "preview:pages": "NEXT_PUBLIC_BASE_PATH=/fawaid bun scripts/serve-export.ts",
    "test:pages": "STATIC_EXPORT=1 NEXT_PUBLIC_BASE_PATH=/fawaid playwright test"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toast": "^1.2.14",
    "@radix-ui/react-tooltip": "^1.2.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.525.0",
    "next": "^16.1.1",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bun-types": "^1.3.4",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5"
  }
}
